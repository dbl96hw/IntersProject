# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# mock = canned responses, no Claude / Supabase / engine. live = real services.
ANALYSIS_MODE=mock

# Data engine (required when ANALYSIS_MODE=live)
DATA_ENGINE_URL=http://localhost:8001
DATA_ENGINE_TIMEOUT_MS=30000

# Claude (required when ANALYSIS_MODE=live). Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Supabase (required when ANALYSIS_MODE=live). Never commit a real key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads

# Uploads and batching
MAX_FILE_MB=10
MAX_FILES=10
BATCH_SIZE=15
MAX_PARALLEL_BATCHES=3
